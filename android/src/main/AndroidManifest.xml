<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- §6.3 Permissions: do not add READ_EXTERNAL_STORAGE / READ_MEDIA_IMAGES /
         READ_MEDIA_VIDEO. §7.3 uses the system photo picker; extra permissions require justification during store review. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- §6.3 No runtime prompt is needed, but recording can fail after microphone authorization without this permission. -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- §10.3 battery optimization whitelist: REQUEST_IGNORE_BATTERY_OPTIMIZATIONS is not in the §6.3 list,
         and app stores restrict it specifically, so the plugin does not declare it for the host. If the host declares it, the system
         whitelist confirmation dialog can be shown directly; otherwise it falls back to the system battery optimization list. See PermissionCoordinator. -->

    <!-- §8.4 Performance 7 / §9.1: Android 14+ back gestures require predictive previews and the
         OnBackPressedDispatcher logic. This flag is required. If the host declares it too,
         add tools:replace="android:enableOnBackInvokedCallback" to the host Manifest. -->
    <application android:enableOnBackInvokedCallback="true">
        <!-- §8.4 The IM WebView is hosted by a native Activity, not a PlatformView.
             If the host app wants it to be the first Activity on cold start (§8.4 Performance 2),
             it only needs to merge a LAUNCHER intent-filter into its own Manifest.
             android:exported is deliberately omitted here: without an intent-filter it defaults to false;
             hard-coding false would cause a merge conflict with exported="true" on the host side. -->
        <activity
            android:name="com.ssg.ssg_shell.ImActivity"
            android:hardwareAccelerated="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.SsgShell.Im"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|density|fontScale|uiMode|layoutDirection|locale" />

        <!-- §8.4 Performance 1: create the WebView and load the landing URL at process startup.
             Host Manifest metadata such as ENTRY_URL lets loading start without waiting for Dart. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="com.ssg.ssg_shell.ShellStartupInitializer"
                android:value="androidx.startup" />
        </provider>
    </application>
</manifest>
