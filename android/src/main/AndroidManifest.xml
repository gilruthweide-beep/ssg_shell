<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- §6.3 权限声明。不要加 READ_EXTERNAL_STORAGE / READ_MEDIA_IMAGES /
         READ_MEDIA_VIDEO —— §7.3 走系统照片选择器，多声明会在市场审核时被追问用途。 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- §6.3 不需要运行时申请，但缺了它用户授权麦克风后 Web 仍会提示无法录音。 -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- §10.3 电池优化白名单。规范要求不在首启弹，只在设置页引导时用。 -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- §8.4 体验与性能 7 / §9.1：Android 14 以上的返回手势要有预览动画并走
         OnBackPressedDispatcher 同一套逻辑，必须声明这个开关。宿主自己也声明了
         同名属性时，在宿主 Manifest 上加 tools:replace="android:enableOnBackInvokedCallback"。 -->
    <application android:enableOnBackInvokedCallback="true">
        <!-- §8.4 IM 的 WebView 由原生 Activity 承载，不是 PlatformView。
             宿主 App 想让它当冷启动第一个 Activity（§8.4 体验与性能 2）时，
             在自己的 Manifest 里 merge 一个 LAUNCHER intent-filter 进来即可。 -->
        <activity
            android:name="com.ssg.ssg_shell.ImActivity"
            android:exported="false"
            android:hardwareAccelerated="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.SsgShell.Im"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|density|fontScale|uiMode|layoutDirection|locale" />

        <!-- §8.4 体验与性能 1：进程启动即创建 WebView 并开始加载入口地址。
             宿主只要在 Manifest 里给 ENTRY_URL 等 meta-data，就不必等 Dart 起来。 -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="com.ssg.ssg_shell.ShellStartupInitializer"
                android:value="androidx.startup" />
        </provider>
    </application>
</manifest>
